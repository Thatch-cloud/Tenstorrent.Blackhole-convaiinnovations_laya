{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:thatch:laya:admission-context:v1",
  "title": "admission-context",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "execution_attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "usage_event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "runtime_generation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "policy_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "reservation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "model": {
      "const": "laya-english"
    },
    "checkpoint_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "issued_at_unix_ms": {
      "type": "integer",
      "minimum": 1
    },
    "deadline_unix_ms": {
      "type": "integer",
      "minimum": 1
    },
    "max_question_rows": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "max_encoded_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32768
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "execution_attempt_id",
    "usage_event_id",
    "tenant_id",
    "key_id",
    "runtime_generation",
    "policy_revision",
    "reservation_id",
    "model",
    "checkpoint_revision",
    "issued_at_unix_ms",
    "deadline_unix_ms",
    "max_question_rows",
    "max_encoded_tokens",
    "request_sha256"
  ],
  "additionalProperties": false
}
