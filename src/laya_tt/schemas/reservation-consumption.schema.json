{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:thatch:laya:reservation-consumption:v1",
  "title": "reservation-consumption",
  "description": "Exact reservation consumption metadata. Encoding is not authentication or authorization. The receiver binds the authenticated host and persisted reservation before committing a single-use consumption.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "binding",
    "deadline_unix_ms",
    "prepared_question_rows",
    "prepared_encoded_tokens"
  ],
  "properties": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "key_id",
        "request_id",
        "execution_attempt_id",
        "reservation_id",
        "usage_event_id",
        "policy_revision",
        "request_sha256",
        "max_question_rows",
        "max_encoded_tokens",
        "runtime"
      ],
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/identity"
        },
        "key_id": {
          "$ref": "#/$defs/identity"
        },
        "request_id": {
          "$ref": "#/$defs/identity"
        },
        "execution_attempt_id": {
          "$ref": "#/$defs/identity"
        },
        "reservation_id": {
          "$ref": "#/$defs/identity"
        },
        "usage_event_id": {
          "$ref": "#/$defs/identity"
        },
        "policy_revision": {
          "$ref": "#/$defs/identity"
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "max_question_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_encoded_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "runtime": {
          "$ref": "#/$defs/runtime"
        }
      }
    },
    "deadline_unix_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "prepared_question_rows": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "prepared_encoded_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32768
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "checkpoint_revision",
        "runtime_revision",
        "runtime_generation",
        "backend"
      ],
      "properties": {
        "model": {
          "const": "laya-english"
        },
        "checkpoint_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "runtime_revision": {
          "$ref": "#/$defs/identity"
        },
        "runtime_generation": {
          "$ref": "#/$defs/identity"
        },
        "backend": {
          "enum": [
            "cpu-reference",
            "tt-blackhole"
          ]
        }
      }
    }
  }
}
