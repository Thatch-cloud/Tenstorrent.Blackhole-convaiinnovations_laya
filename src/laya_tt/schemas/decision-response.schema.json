{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:thatch:laya:decision-response:v1",
  "title": "decision-response",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "model": {
      "const": "laya-english"
    },
    "checkpoint_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "runtime_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "runtime_generation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "backend": {
      "enum": [
        "cpu-reference",
        "tt-blackhole"
      ]
    },
    "answers": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "choice"
              },
              "choice": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "probabilities": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 64,
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "answer_confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "action": {
                "type": "object",
                "properties": {
                  "act_probability": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "act_probability"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "choice",
              "probabilities",
              "confidence",
              "answer_confidence",
              "action"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "score"
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 63
              },
              "legend": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 64,
                "propertyNames": {
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "probabilities": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 64,
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "propertyNames": {
                  "pattern": "^(0|[1-9][0-9]*)$"
                }
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "answer_confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "action": {
                "type": "object",
                "properties": {
                  "act_probability": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "act_probability"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "score",
              "legend",
              "probabilities",
              "confidence",
              "answer_confidence",
              "action"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "noul"
              },
              "noul": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "answer_confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "action": {
                "type": "object",
                "properties": {
                  "act_probability": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "act_probability"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "noul",
              "confidence",
              "answer_confidence",
              "action"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "usage": {
      "type": "object",
      "properties": {
        "requests": {
          "const": 1
        },
        "question_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "encoded_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "output_tokens": {
          "const": 0
        },
        "queue_ms": {
          "type": "integer",
          "minimum": 0
        },
        "execution_ms": {
          "type": "integer",
          "minimum": 0
        },
        "accelerator_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "requests",
        "question_rows",
        "encoded_tokens",
        "output_tokens",
        "queue_ms",
        "execution_ms"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "model",
    "checkpoint_revision",
    "runtime_revision",
    "runtime_generation",
    "backend",
    "answers",
    "usage"
  ],
  "additionalProperties": false
}
