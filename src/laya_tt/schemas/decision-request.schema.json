{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:thatch:laya:decision-request:v1",
  "title": "decision-request",
  "type": "object",
  "properties": {
    "model": {
      "const": "laya-english"
    },
    "state": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 50000
        },
        {
          "type": "object"
        },
        {
          "type": "array"
        }
      ]
    },
    "questions": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "choice"
              },
              "instructions": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "criteria": {
                "oneOf": [
                  {
                    "type": "object",
                    "minProperties": 1,
                    "maxProperties": 64,
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    }
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "minItems": 1,
                    "maxItems": 64,
                    "uniqueItems": true
                  }
                ]
              }
            },
            "required": [
              "type",
              "instructions",
              "criteria"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "score"
              },
              "instructions": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "criteria": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "minItems": 1,
                "maxItems": 64
              }
            },
            "required": [
              "type",
              "instructions",
              "criteria"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "noul"
              },
              "instructions": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "criteria": {
                "type": "object",
                "properties": {
                  "true": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "false": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": [],
                "additionalProperties": false
              },
              "labels": {
                "type": "object",
                "properties": {
                  "true": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "false": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "required": [],
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "instructions"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "model",
    "state",
    "questions"
  ],
  "additionalProperties": false
}
